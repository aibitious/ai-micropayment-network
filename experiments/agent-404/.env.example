# Copy to .env; never commit .env or use these example values in production.
DB_PATH=/data/404.sqlite3
ANON_HASH_SECRET=REPLACE_WITH_GENERATED_32_BYTE_SECRET
ADMIN_TOKEN=REPLACE_WITH_GENERATED_ADMIN_TOKEN
CLIENT_DAILY_LIMIT=100
CLIENT_MINUTE_LIMIT=5
UPSTREAM_DAILY_LIMIT=150
# Exactly the public hostname and local loopback names, no wildcards on the public domain.
MCP_ALLOWED_HOSTS=aibitious.com,404.aibitious.com,localhost:*,127.0.0.1:*

# Set to the exact IP of the trusted TLS reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# Caddy's exact Docker IP; never wildcard.
TRUSTED_PROXY_IPS=172.29.0.3

MCP_REGISTRY_STATUS=not_registered
